PORT=5000
MONGO_URI=mongodb://localhost:27017/cloud
# NOTE: Generate a new secret for each environment and rotate periodically.
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-random-secret-in-production
PROXMOX_HOST=192.168.1.100
PROXMOX_PORT=8006
PROXMOX_USER=root@pam
# Set to a strong password. Never commit real credentials.
PROXMOX_PASSWORD=your-proxmox-password
# SSH keypair auto-generated at .ssh/cloud(.pub) on first start.
# Used for console (lxc-attach) — ensure the Proxmox host's
# authorized_keys includes the public key from .ssh/cloud.pub.
PROXMOX_NODE=proxmox
PROXMOX_SSL_VERIFY=false
CORS_ORIGINS=http://localhost,http://localhost:3000,http://192.168.1.100,http://192.168.1.100:3000
LOG_LEVEL=info
